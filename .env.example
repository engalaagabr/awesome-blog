# Local application
DATABASE_URL=sqlite+aiosqlite:///./blog.db

# Docker Compose
DOCKER_DATABASE_URL=sqlite+aiosqlite:////data/blog.db
BLOG_PORT=8082

# Authentication
# Generate a private key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=30
# Absolute session lifetime; refresh rotation does not extend this deadline.
REFRESH_TOKEN_DAYS=7
