# PostgreSQL (local tools connect through localhost; Compose uses the db service name)
POSTGRES_DB=awesome_blog
POSTGRES_USER=awesome_blog
POSTGRES_PASSWORD=replace_with_a_long_url_safe_password
DATABASE_URL=postgresql+asyncpg://awesome_blog:replace_with_a_long_url_safe_password@localhost:5432/awesome_blog
POSTGRES_PORT=5432

# Docker Compose
BLOG_PORT=8082

# Authentication
# Generate a private key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=30
# Absolute session lifetime; refresh rotation does not extend this deadline.
REFRESH_TOKEN_DAYS=7
